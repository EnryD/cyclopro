{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Réparations{% endblock %}

{% block body %}
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 mb-0"><i class="bi bi-list-check"></i> Demandes de réparation</h1>
        <a class="btn btn-primary" href="{{ path('app_ajout_reparation') }}">Nouvelle réparation</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                    <th scope="col">Dépôt</th>
                    <th scope="col">Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for reparation in reparations|sort((a, b) => a.dateDepot <=> b.dateDepot) %}
                    <tr>
                        <td>{{ reparation.typeReparation }}</td>
                        <td>{{ reparation.description }}</td>
                        <td>{{ reparation.dateDepot|date('d/m/Y') }}</td>
                        <td>{{ reparation.statut|capitalize }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucune demande de réparation pour le moment.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
